plugin 'cocoapods-user-defined-build-types'

enable_user_defined_build_types!

# The IDMission SDK expects SocketRocket as its own dynamic framework (see the
# pod below). React Native's prebuilt ReactNativeDependencies bundles a static
# SocketRocket facade that conflicts with it, so build RN's third-party deps
# from source instead. The prebuilt React core links the prebuilt
# ReactNativeDependencies framework, so it must be built from source too.
ENV['RCT_USE_RN_DEP'] ||= '0'
ENV['RCT_USE_PREBUILT_RNCORE'] ||= '0'

# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, min_ios_version_supported
prepare_react_native_project!

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'IDMTest' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  # IDMission SDK dependencies
  pod 'WebRTC', :build_type => :dynamic_framework
  pod 'CocoaLumberjack', :build_type => :dynamic_framework
  pod 'SocketRocket', :build_type => :dynamic_framework
  pod 'IdmEncryption', :build_type => :dynamic_framework
  pod 'TensorFlowLiteObjC'
  pod 'GoogleMLKit/TextRecognition', '3.2.0' , :build_type => :dynamic_framework
  pod 'GoogleMLKit/FaceDetection', '3.2.0' , :build_type => :dynamic_framework
  pod 'Firebase/Crashlytics' , :build_type => :dynamic_framework
  pod 'Firebase/Analytics' , :build_type => :dynamic_framework

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )

    # Older SDK dependencies (Firebase 10, MLKit 3.2, ...) declare iOS 9-11
    # deployment targets, which current Xcode rejects. Raise them to RN's floor.
    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |config|
        current = config.build_settings['IPHONEOS_DEPLOYMENT_TARGET']
        if current && Gem::Version.new(current) < Gem::Version.new(min_ios_version_supported)
          config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = min_ios_version_supported
        end
      end
    end
  end
end
